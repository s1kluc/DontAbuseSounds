{
  "productName": "DontAbuseSounds",
  "version": "0.2.0",
  "identifier": "com.s1kluc.dontabusesounds",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "DontAbuseSounds", "width": 870, "height": 735, "minWidth": 500, "minHeight": 580 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist" }
  }
}
